{
  "id": "dev.mccue.jigsaw.moduleSet",
  "lexicon": 1,
  "defs": {
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.moduleSet#attribute"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.moduleSet#module"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.moduleSet#attribute"
          }
        }
      }
    },
    "main": {
      "type": "record",
      "description": "A set of JVM modules tightly versioned together.",
      "key": "any",
      "record": {
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "minLength": 1,
            "description": "Variants of the same module at the same 'version'",
            "items": {
              "type": "ref",
              "ref": "dev.mccue.jvm.moduleSet#variant"
            }
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "variants",
          "createdAt"
        ],
        "type": "object"
      }
    }
  }
}
