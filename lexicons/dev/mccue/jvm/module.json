{
  "id": "dev.mccue.jvm.module",
  "lexicon": 1,
  "defs": {
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "accept": [
            "application/zip",
            "application/java-archive"
          ],
          "maxSize": 10000000,
          "type": "blob"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.module#attribute"
          }
        }
      }
    },
    "main": {
      "type": "record",
      "description": "A JVM Module published for wider consumption.",
      "key": "any",
      "record": {
        "properties": {
          "variants": {
            "type": "array",
            "minLength": 1,
            "description": "Variants of the same module at the same 'version'",
            "items": {
              "type": "ref",
              "ref": "dev.mccue.jvm.module#variant"
            }
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "variants",
          "createdAt"
        ],
        "type": "object"
      }
    }
  }
}
