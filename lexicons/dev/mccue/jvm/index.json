{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "dev.mccue.jvm.index",
  "defs": {
    "variant": {
      "type": "object",
      "required": [
        "source",
        "moduleInfo"
      ],
      "properties": {
        "license": {
          "description": "SPDX License String",
          "type": "string"
        },
        "billOfMaterials": {
          "description": "SBOM in CycloneDX format",
          "type": "string"
        },
        "source": {
          "type": "union",
          "refs": [
            "com.atproto.repo.strongRef"
          ],
          "description": "A reference to where this module was copied from."
        },
        "operatingSystem": {
          "type": "ref",
          "ref": "dev.mccue.jvm.operatingSystem"
        },
        "cpuArchitecture": {
          "type": "ref",
          "ref": "dev.mccue.jvm.cpuArchitecture"
        },
        "moduleInfo": {
          "ref": "dev.mccue.jvm.moduleInfo",
          "type": "ref"
        }
      }
    },
    "moduleVersion": {
      "type": "object",
      "required": [
        "variants"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.jvm.index#variant"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.jvm.index#moduleVersion"
          }
        }
      }
    },
    "main": {
      "type": "record",
      "description": "An index of where one might find a particular module",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "providers"
        ],
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "dev.mccue.jvm.index#provider"
            }
          }
        }
      }
    }
  }
}