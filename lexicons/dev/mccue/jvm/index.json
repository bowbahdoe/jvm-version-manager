{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "dev.mccue.jvm.index",
  "defs": {
    "moduleVersion": {
      "type": "object",
      "required": [
        "version",
        "module"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "ref": "com.atproto.repo.strongRef",
          "type": "ref",
          "description": "A reference to the module in the provider repo"
        },
        "moduleInfo": {
          "ref": "dev.mccue.jvm.moduleInfo",
          "type": "ref"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "dev.mccue.jvm.index#moduleVersion"
          }
        }
      }
    },
    "main": {
      "type": "record",
      "description": "An index of where one might find a particular module",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "providers"
        ],
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "dev.mccue.jvm.index#provider"
            }
          }
        }
      }
    }
  }
}